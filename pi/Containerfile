# Pi coding agent image, on top of the podman-in-podman base image from
# ../base/Containerfile. `make pi` builds the base images first.
# The base image ends as the main user (UID 1000) with HOME set, and has
# Node.js, with `npm install -g` going to ~/.local.
#
# Pi has MCP and codemode built in. The image turns codemode on for every
# session, and adds subagents (the subagent example extension shipped in the
# pi package) and web access (the pi-web-access package).

ARG BASE_IMAGE=localhost/base/podman-in-podman:latest

FROM ${BASE_IMAGE}

# npm releases, pinned. Upgrade by changing them and rebuilding.
ARG PI_VERSION=1.3.0

# Turns off the pi.dev latest-version check, install and update telemetry,
# and the provider attribution headers. A newer pi comes from a rebuild with
# a new PI_VERSION, not from `pi update`.
ENV PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0

# pi's install instructions skip install scripts; the package needs none.
# Binaries go to ~/.local/bin. npm's download cache, ~/.npm, is a cache
# mount owned by the user: it stays out of the image and is reused by the
# next build, which then downloads only the packages that changed.
RUN --mount=type=cache,target=${HOME}/.npm,uid=1000,gid=1000 \
    npm install -g --no-fund --no-audit --ignore-scripts \
        "@earendil-works/pi-coding-agent@${PI_VERSION}" \
 && pi --version \
 && pi install npm:pi-subagents \
 && pi install npm:pi-pigment \
 && pi install npm:pi-web-access \
 && pi install npm:@juicesharp/rpiv-ask-user-question \
 && pi install npm:@juicesharp/rpiv-todo

CMD ["pi"]
