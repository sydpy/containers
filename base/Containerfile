# Base images for development containers, one per target. Each target
# builds on the previous one:
#
#   base              non-root main user and base packages
#   dev               development tools: Rust (rustup), Python (uv), Node.js
#   podman-in-podman  rootless podman for the user, nested in the outer one
#
# ../compose/base.yml names them localhost/base/<target>:latest, and
# ../Makefile builds them in order. Every target ends as the main user,
# with HOME set, so an image built FROM one of them starts as that user and
# switches to root only for the steps that need it.
#
# apt runs with /var/cache/apt and /var/lib/apt/lists as cache mounts, which
# keeps them out of the image and reuses them between builds.

ARG BASE_IMAGE=docker.io/library/debian:trixie-slim
# Node.js image the dev target copies node, npm and corepack from (24, LTS,
# the last release line that bundles corepack)
ARG NODE_IMAGE=docker.io/library/node:24-trixie-slim
# Name of the non-root main user, UID 1000
ARG USERNAME=user

# -----------------------------------------------------------------------------
# Only a source for COPY --from in the dev target. As a stage, the image is
# resolved once, so node and node_modules come from the same release.
FROM ${NODE_IMAGE} AS node

# -----------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS base
ARG USERNAME

# The base image's docker-clean would delete the downloaded packages after
# each install, defeating the apt cache mounts. Keep-Downloaded-Packages
# stops the `apt` command (not apt-get) from deleting them too.
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
 && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' \
        > /etc/apt/apt.conf.d/keep-cache

# The slim base image's /etc/dpkg/dpkg.cfg.d/docker excludes
# /usr/share/man/*. The file below, read after it, lets the English man
# pages back in; translations stay out. The packages already in the base
# image were unpacked without theirs, so the ones that ship man pages are
# reinstalled. man-db indexes the pages, and its dpkg trigger updates the
# index whenever a later install adds more.
RUN printf '%s\n' 'path-include /usr/share/man/man*' \
        > /etc/dpkg/dpkg.cfg.d/man-pages

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends --reinstall \
        $(dpkg -S '/usr/share/man/man*' | sed 's/: .*//; s/, /\n/g' | sort -u) \
 && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        fd-find \
        git \
        gnupg \
        less \
        libssl-dev \
        man-db \
        manpages \
        manpages-dev \
        openssh-client \
        pkg-config \
        procps \
        ripgrep \
        hx

# The user has UID 1000, so it can be mapped to the host user with
# --userns=keep-id:uid=1000,gid=1000 and write to a project mounted on
# /workspace. useradd gives the user subordinate IDs from 100000, outside
# the IDs 0 to 65535 a rootless container usually has, so they are replaced
# with every ID from 1 to 65535 except the user's own, as in the podman
# project's quay.io/podman/stable image.
RUN useradd --create-home --uid 1000 --user-group --shell /bin/bash "${USERNAME}" \
 && printf '%s\n' "${USERNAME}:1:999" "${USERNAME}:1001:64535" > /etc/subuid \
 && cp /etc/subuid /etc/subgid \
 && install -d -o "${USERNAME}" -g "${USERNAME}" /workspace

ENV HOME=/home/${USERNAME}
ENV EDITOR=hx
WORKDIR /workspace
USER ${USERNAME}

# -----------------------------------------------------------------------------
FROM base AS dev
ARG USERNAME
# Rust toolchain installed by rustup
ARG RUST_TOOLCHAIN=stable
# Python installed by uv
ARG PYTHON_VERSION=3.14

# Debian's rustup has self-update disabled and links cargo, rustc and the
# other tools into /usr/bin. Toolchains go to ~/.rustup, and binaries from
# `cargo install` land in ~/.cargo/bin.
USER root
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends rustup
# uv, copied from Astral's image of the release pinned here, see
# https://docs.astral.sh/uv/guides/integration/docker/
COPY --from=ghcr.io/astral-sh/uv:0.12.24 /uv /uvx /usr/local/bin/

# Node.js, copied from the node stage (NODE_IMAGE). The image puts node in
# /usr/local/bin and npm, npx and corepack in /usr/local/lib/node_modules.
# Its /usr/local/bin also links to yarn under /opt, which isn't copied, so
# only node is copied from there and the other links are made here.
COPY --from=node /usr/local/bin/node /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

USER ${USERNAME}
RUN rustup toolchain install "${RUST_TOOLCHAIN}" \
        --profile minimal --component clippy,rustfmt \
 && rustup default "${RUST_TOOLCHAIN}" \
 && cargo --version \
 && rustc --version

# With --default, uv installs python and python3 as well as python3.14 into
# ~/.local/bin, where binaries from `uv tool install` also go.
RUN uv python install --default "${PYTHON_VERSION}" \
 && "${HOME}/.local/bin/python3" --version

# `npm install -g` installs to the user's ~/.local, with binaries in
# ~/.local/bin, rather than to the root-owned /usr/local. Corepack's pnpm
# and yarn shims go there too; corepack downloads the package manager a
# project asks for on first use, without prompting. node-gyp builds native
# modules with build-essential and the python3 from uv. npm's cache
# directory, ~/.npm, is made here so that the user owns it: images built on
# this one mount a build cache there, and podman would otherwise create the
# mount point owned by root, leaving npm unable to write its cache at run
# time.
ENV NPM_CONFIG_PREFIX=/home/${USERNAME}/.local \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN mkdir -p "${HOME}/.npm" \
 && corepack enable --install-directory "${HOME}/.local/bin" \
 && node --version \
 && npm --version

ENV PATH=/home/${USERNAME}/.cargo/bin:/home/${USERNAME}/.local/bin:${PATH}

# -----------------------------------------------------------------------------
# Podman in podman: the user runs rootless podman, and each inner container
# gets a user namespace nested in the outer container's. At run time it
# needs these options, and no added capabilities (see compose/claude.yml):
#   --device /dev/net/tun  (pasta networking for inner containers)
#   --device /dev/fuse  (fuse-overlayfs for the inner podman's storage)
#   --security-opt unmask=ALL  (inner podman mounts a fresh /proc)
#   --security-opt label=type:container_engine_t  (SELinux hosts)
#   --tmpfs /run/user/1000:mode=0700,U  (see below)
FROM dev AS podman-in-podman
ARG USERNAME

# aardvark-dns, catatonit, nftables, passt and uidmap are only recommended
# by podman, and --no-install-recommends skips them. The inner podman needs
# them for DNS between compose services, for --init (compose's
# "init: true"), for netavark's bridge networks, for pasta networking, and
# for newuidmap and newgidmap. fuse-overlayfs is the overlay mount program
# in files/storage.conf. libcap2-bin is for setcap, used below.
USER root
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends \
        aardvark-dns \
        catatonit \
        fuse-overlayfs \
        libcap2-bin \
        nftables \
        passt \
        podman \
        podman-compose \
        uidmap

# newuidmap and newgidmap are setuid root, so they write the inner user
# namespace's uid_map and gid_map with euid 0. The user is then not the
# owner of that namespace, and the kernel wants CAP_SYS_ADMIN in the outer
# one, which the outer container doesn't have: the write fails with EPERM.
# With file capabilities instead, as in quay.io/podman/stable, they keep
# the user's UID and only gain CAP_SETUID or CAP_SETGID.
RUN chmod 0755 /usr/bin/newuidmap /usr/bin/newgidmap \
 && setcap cap_setuid=ep /usr/bin/newuidmap \
 && setcap cap_setgid=ep /usr/bin/newgidmap

# There is no systemd and no writable cgroup tree, so cgroups are off and
# events and logs go to files rather than journald. Inner containers share
# the outer UTS namespace, since seccomp blocks sethostname without
# CAP_SYS_ADMIN.
COPY files/containers.conf files/storage.conf /etc/containers/

# Podman keeps its runtime state under XDG_RUNTIME_DIR and expects it to be
# empty at boot. A container that is stopped and started again keeps its
# files, so the directory must be a tmpfs, which is empty at every start.
# The directory made here is only the mount point.
ENV XDG_RUNTIME_DIR=/run/user/1000
RUN install -d -m 0700 -o "${USERNAME}" -g "${USERNAME}" "${XDG_RUNTIME_DIR}"

# Overlay cannot use the outer container's overlay root as its upper layer,
# so the inner podman's storage lives on a volume. Each container gets its
# own anonymous volume. `podman run --rm` removes it with the container;
# `podman-compose down` keeps it unless given -v.
USER ${USERNAME}
RUN mkdir -p "${HOME}/.local/share/containers"
VOLUME /home/${USERNAME}/.local/share/containers
